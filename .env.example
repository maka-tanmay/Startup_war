VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional when the CLI runner is hosted separately from Vite.
VITE_COUNCIL_ENDPOINT=http://127.0.0.1:8787/api/council

# Server-only council runner settings. Never prefix these with VITE_.
SPARKTANK_CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
SPARKTANK_COUNCIL_MODEL=
SPARKTANK_COUNCIL_PORT=8787
SPARKTANK_ALLOWED_ORIGIN=http://localhost:5173

# Use deterministic council output for UI testing without model calls.
SPARKTANK_COUNCIL_MOCK=0
